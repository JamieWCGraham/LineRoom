# Supabase (Auth + profiles)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for /api/chat (set in Vercel project env)
OPENAI_API_KEY=

# Optional shared model fallback — defaults to gpt-5-mini
# OPENAI_MODEL=gpt-5-mini

# Optional dual-path overrides for /api/chat
# OPENAI_FAST_MODEL=gpt-5-mini
# OPENAI_DEEP_MODEL=gpt-5

# Optional — Langfuse observability (omit to run without tracing)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# EU cloud (default). US: https://us.cloud.langfuse.com — self-host: your instance URL
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
