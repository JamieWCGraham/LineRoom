# Supabase (Auth + profiles)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# OAuth (Google + Apple): enable each provider in Supabase Dashboard → Authentication → Providers,
# add client IDs/secrets there, and add this redirect URL to Authentication → URL Configuration
# (must match NEXT_PUBLIC_SITE_URL origin), e.g. https://your-production-host.example/auth/callback
# (same origin as production; no query string required — post-login path uses a short-lived cookie.)
#
# Password recovery + email confirmation: also allow
#   {NEXT_PUBLIC_SITE_URL}/auth/confirm
# (local + production). Forgot-password uses resetPasswordForEmail with redirectTo that URL
# and next=/reset-password. Recovery emails are sent by Supabase Auth (same SMTP as signup).
#
# Google Cloud Console → OAuth Web client:
#   Authorized JavaScript origins: https://your-production-host.example, http://localhost:3000
#   Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#   (NOT your Next /auth/callback — Google redirects to Supabase first.)
#
# Apple Developer (Sign in with Apple — web via Supabase):
#   1. App ID: enable Sign in with Apple (e.g. com.phasespace.lineroom — same as APPLE_BUNDLE_ID).
#   2. Services ID: create one for web (e.g. com.phasespace.lineroom.web).
#   3. Services ID → Configure → Domains: hxtpvhpqlumfujyjhret.supabase.co
#      Return URL: https://hxtpvhpqlumfujyjhret.supabase.co/auth/v1/callback
#   4. Keys: create Sign in with Apple key; download AuthKey_XXXXX.p8 (rotate every 6 months).
#   5. Supabase Dashboard → Auth → Providers → Apple:
#      Services ID, Secret Key (from .p8), Team ID, Key ID.
#      If you also use native iOS Sign in with Apple later, list the Services ID **first**
#      in Client IDs (Supabase uses the first ID for web OAuth).
#
# Show "Continue with Google" on /login and /signup after the provider is configured:
# NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=true
# Show Apple when configured in Supabase (default off):
# NEXT_PUBLIC_OAUTH_APPLE_ENABLED=true
#
# Server-only: required for Stripe webhooks and checkout customer upserts
SUPABASE_SERVICE_ROLE_KEY=

# Private Supabase Storage bucket for per-piece voice memos (see Supabase dashboard)
# SUPABASE_DRAFT_RECORDINGS_BUCKET=draft-recordings

# Private bucket for batch critique eval outputs (create in dashboard; default name below)
# SUPABASE_LINE_ROOM_EVALS_BUCKET=line-room-evals
# Parallel LLM calls per eval batch (default 8, max 32)
# LINE_ROOM_EVAL_BATCH_CONCURRENCY=8
# Parallel storage downloads for eval metrics (default 16, max 48)
# LINE_ROOM_EVAL_METRICS_CONCURRENCY=16

# Optional — privacy-friendly analytics. Empty key disables all tracking (no network calls).
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_ANALYTICS_DOMAIN_OR_KEY=line-room.com
# PostHog alternative: NEXT_PUBLIC_ANALYTICS_PROVIDER=posthog and a project key.
# Disable explicitly: NEXT_PUBLIC_ANALYTICS_PROVIDER=none

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used for Stripe success/cancel URLs (falls back to NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Capacitor iOS (remote URL shell) — see .cursor/specs/capacitor-ios.md
# Canonical HTTPS origin for production; must match Supabase redirect allowlist and Stripe return URLs.
# Override for `cap sync` without changing Next public vars:
# CAPACITOR_SERVER_URL=https://your-production-host.example
# Local HTTP to a dev machine (not for App Store): CAPACITOR_CLEARTEXT=true
# Optional hosts/patterns for in-WebView OAuth or Stripe (comma-separated).
# Keep in sync with Supabase redirect allowlist — see MOBILE_DEPLOYMENT.md.
# CAPACITOR_ALLOW_NAVIGATION=line-room.com,*.supabase.co,*.stripe.com,accounts.google.com,appleid.apple.com

# iOS In-App Purchase (StoreKit 2) — product id from App Store Connect
# App Store Connect metadata (Guideline 3.1.2): Privacy Policy URL → {NEXT_PUBLIC_APP_URL}/privacy
# Terms of Use (EULA, standard Apple) → https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
# (or {NEXT_PUBLIC_APP_URL}/eula, which redirects to the same)
# NEXT_PUBLIC_IOS_IAP_PRODUCT_ID=com.phasespace.lineroom.pro.monthly
# IOS_IAP_PRODUCT_ID=com.phasespace.lineroom.pro.monthly
# APPLE_BUNDLE_ID=com.phasespace.lineroom
# APPLE_IAP_ENVIRONMENT=sandbox
# Production JWS verification requires numeric App ID from App Store Connect:
# APPLE_APP_STORE_APP_ID=1234567890
# Optional: set to false if OCSP checks fail on your host
# APPLE_IAP_ONLINE_CERT_CHECKS=true
# Optional Bearer for POST /api/billing/ios/app-store-notifications
# APP_STORE_NOTIFICATION_AUTH_SECRET=

# Stripe (LineRoom Pro — monthly subscription)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=

# Billing bypass — unlimited critiques, no subscription (comma-separated, case-insensitive)
BILLING_BYPASS_EMAILS=jgraham0@msn.com

# Internal evals UI + /api/evals (comma-separated; defaults to jgraham0@msn.com if unset)
EVALS_ACCESS_EMAILS=jgraham0@msn.com

# Free-tier successful critique generations (default 25 if unset/invalid)
FREE_CRITIQUE_QUOTA=25

# Guest try (anonymous auth) critique generations (default 3 if unset/invalid)
# Enable Anonymous sign-ins in Supabase Dashboard → Authentication → Providers.
GUEST_CRITIQUE_QUOTA=3

# Required for /api/chat (set in Vercel project env)
OPENAI_API_KEY=

# Required for POST /api/critique — Vercel AI Gateway (OpenAI-compatible)
# https://vercel.com/docs/ai-gateway/openai-compat
AI_GATEWAY_API_KEY=
# Optional alias for the same key:
# VERCEL_AI_GATEWAY_API_KEY=
# Optional override (default https://ai-gateway.vercel.sh/v1)
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Critique model on the gateway: set full id OR use toggle below.
# Full id examples: openai/gpt-5-mini | google/gemini-3.1-pro-preview
# (Non-openai/* models omit OpenAI json_object mode on the gateway to avoid 400 "malformed body".)
# CRITIQUE_GATEWAY_MODEL=openai/gpt-5-mini

# When CRITIQUE_GATEWAY_MODEL is unset: openai → openai/gpt-5-mini, gemini → google/gemini-3.1-pro-preview
# CRITIQUE_LLM_PROVIDER=openai
# CRITIQUE_OPENAI_GATEWAY_MODEL=openai/gpt-5-mini
# CRITIQUE_GEMINI_GATEWAY_MODEL=google/gemini-3.1-pro-preview

# Optional shared model fallback — defaults to gpt-5-mini
# OPENAI_MODEL=gpt-5-mini

# Global draft fingerprint gate before critique LLM (default on). Set false to disable.
# DRAFT_CRITIQUE_GATE_ENABLED=true

# One lagged retry (ms) for critique after connection / 5xx / 429 from the gateway (default 2500)
# LINE_ROOM_CRITIQUE_NETWORK_RETRY_DELAY_MS=2500

# Optional dual-path overrides for /api/chat
# OPENAI_FAST_MODEL=gpt-5-mini
# OPENAI_DEEP_MODEL=gpt-5

# Headless critique eval API: POST /api/dev/generate-critique-eval (Bearer token)
# LINEROOM_CRITIQUE_EVAL_SECRET=

# Optional — /evals/commits GitHub feed (owner/repo). Default: JamieWCGraham/LineRoom
# GITHUB_REPOSITORY=owner/repo
# Required for private repos (otherwise GitHub returns 404). Optional on public repos for rate limits.
# GITHUB_TOKEN=ghp_...

# Optional — model for /evals/commits “Summarize” (defaults to CRITIQUE_GATEWAY_MODEL)
# COMMIT_SUMMARY_GATEWAY_MODEL=google/gemini-2.0-flash-001

# Optional — Langfuse observability (omit to run without tracing)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# EU cloud (default). US: https://us.cloud.langfuse.com — self-host: your instance URL
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
